{
  "info": {
    "name": "Buoi03 Auth",
    "description": "Chạy npm run seed trước. Chạy thư mục 0 đến 4 bằng Collection Runner theo thứ tự; mỗi lần chạy tạo email/điện thoại mới nên chạy lại không bị 409 ngoài ý muốn. Thư mục 5 chạy thủ công theo hướng dẫn trong mô tả của nó. Route tạm role-check đã xóa sau kiểm thử, phân quyền được kiểm tra trên GET /api/management/categories (authorize MANAGER, ADMIN). Không lưu token trong file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 - Dang ky",
      "item": [
        {
          "name": "Dang ky Customer moi (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now().toString();",
                  "pm.collectionVariables.set(\"runId\", runId);",
                  "pm.collectionVariables.set(\"regEmail\", `customer_${runId}@example.com`);",
                  "pm.collectionVariables.set(\"regPhone\", `09${runId.slice(-8)}`);",
                  "pm.collectionVariables.set(\"regPhone2\", `08${runId.slice(-8)}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Không trả password_hash\", () => pm.expect(JSON.stringify(pm.response.json())).to.not.include(\"password_hash\"));",
                  "const data = pm.response.json().data;",
                  "pm.test(\"Role CUSTOMER, ACTIVE\", () => {",
                  "  pm.expect(data.role).to.eql(\"CUSTOMER\");",
                  "  pm.expect(data.status).to.eql(\"ACTIVE\");",
                  "});",
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"userId\", pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Nguyễn Văn A\",\n  \"email\": \"{{regEmail}}\",\n  \"phone\": \"{{regPhone}}\",\n  \"password\": \"HocVien@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
